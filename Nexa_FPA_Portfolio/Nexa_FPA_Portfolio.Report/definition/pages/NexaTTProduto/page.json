{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "NexaTTProduto",
  "displayName": "Tooltip | Produto",
  "displayOption": "FitToPage",
  "width": 480,
  "height": 320,
  "visibility": "HiddenInViewMode",
  "type": "Tooltip",
  "pageBinding": {
    "name": "NexaTTProdutoBinding",
    "type": "Tooltip",
    "acceptsFilterContext": "Default"
  },
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#FFFFFF'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "pageInformation": [
      {
        "properties": {
          "pageInformationType": {
            "expr": {
              "Literal": {
                "Value": "'Tooltip'"
              }
            }
          }
        }
      }
    ]
  }
}
