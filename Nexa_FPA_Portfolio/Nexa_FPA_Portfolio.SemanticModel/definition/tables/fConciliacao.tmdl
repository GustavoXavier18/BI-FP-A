/// Conciliação histórica de 12 contas patrimoniais, com abertura explícita.
table 'fConciliacao'
	lineageTag: 8e755588-2e06-5baa-92bb-e60c7b15f292

	column 'Data'
		dataType: dateTime
		sourceColumn: Data
		summarizeBy: none
		lineageTag: 7bffba20-ee5c-5def-9b62-f12fdd874bef
		formatString: dd/MM/yyyy
		isHidden

	column 'ContaID'
		dataType: string
		sourceColumn: ContaID
		summarizeBy: none
		lineageTag: 9dc6540f-5d04-5876-95e4-611c44f02388
