	column 'Campo'
		dataType: string
		sourceColumn: Campo
		summarizeBy: none
		lineageTag: 773abe83-7db8-532a-8b90-31cc92760c30
		isHidden

	column 'SaldoDiario'
		dataType: double
		sourceColumn: SaldoDiario
		summarizeBy: none
		lineageTag: 571f5af4-7c07-5c76-b6d2-1305a8892b0f
		isHidden

	column 'SaldoModelo'
		dataType: double
