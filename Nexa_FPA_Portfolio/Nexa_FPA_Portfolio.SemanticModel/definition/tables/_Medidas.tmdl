			RETURN CALCULATE(MAX(fPremissas[DIO]), KEEPFILTERS(dCenario[Cenario]=C), KEEPFILTERS(dCalendario[Data]=M))
		formatString: 0" dias"
		displayFolder: 11 | Cenários
