	/// Desvio Real x Orçado R$. Respeita o período selecionado e as convenções financeiras do Excel.
	measure 'Desvio Real x Orçado R$' =
			IF(NOT ISBLANK([Realizado]) && NOT ISBLANK([Orçamento]), [Realizado] - [Orçamento])
