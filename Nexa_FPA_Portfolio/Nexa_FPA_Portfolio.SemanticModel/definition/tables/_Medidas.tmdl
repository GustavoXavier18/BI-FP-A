			VAR C = [Cenário Efetivo]
			VAR M = [Último Mês]
			RETURN IF([Seleção de Cenário Válida] = 1 && NOT ISBLANK(M), CALCULATE(SUM(fFinanceiro[DIO]), KEEPFILTERS(dCenario[Cenario] = C), KEEPFILTERS(dCalendario[Data] = M)))
		formatString: 0" dias"
		displayFolder: 07 | Capital de Giro
